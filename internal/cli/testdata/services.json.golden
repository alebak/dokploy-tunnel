{
  "context": "prod",
  "projects": [
    {
      "id": "prj_shop",
      "name": "shop",
      "environments": [
        {
          "id": "env_shop_prod",
          "name": "production",
          "default": true,
          "services": [
            {
              "id": "app_web",
              "type": "application",
              "kind": "service",
              "name": "web",
              "status": "done",
              "default_port": null
            },
            {
              "id": "cmp_stack",
              "type": "compose",
              "kind": "service",
              "name": "observability",
              "status": "running",
              "default_port": null,
              "warning": "internal services unknown: Dokploy has no compose file cached for it yet; deploy it once"
            },
            {
              "id": "pg_main",
              "type": "postgres",
              "kind": "service",
              "name": "main-db",
              "status": "done",
              "default_port": 5432
            },
            {
              "id": "redis_cache",
              "type": "redis",
              "kind": "service",
              "name": "cache",
              "status": "error",
              "default_port": 6379
            }
          ]
        },
        {
          "id": "env_shop_stg",
          "name": "staging",
          "default": false,
          "services": [
            {
              "id": "maria_stg",
              "type": "mariadb",
              "kind": "service",
              "name": "legacy-db",
              "status": "idle",
              "default_port": 3306
            },
            {
              "id": "cmp_myapp",
              "type": "compose",
              "kind": "service",
              "name": "myapp",
              "status": "done",
              "default_port": null
            },
            {
              "id": "cmp_myapp/postgres",
              "type": "compose_service",
              "kind": "compose_service",
              "name": "myapp/postgres",
              "status": "",
              "default_port": null,
              "parent": "cmp_myapp",
              "service": "postgres"
            },
            {
              "id": "cmp_myapp/pgadmin",
              "type": "compose_service",
              "kind": "compose_service",
              "name": "myapp/pgadmin",
              "status": "",
              "default_port": null,
              "parent": "cmp_myapp",
              "service": "pgadmin"
            },
            {
              "id": "libsql_edge",
              "type": "libsql",
              "kind": "service",
              "name": "",
              "status": "",
              "default_port": 8080,
              "warning": "name and status unknown: Dokploy rejected the API key (HTTP 401 from libsql.one)"
            }
          ]
        },
        {
          "id": "env_shop_preview",
          "name": "preview",
          "default": false,
          "services": []
        }
      ]
    },
    {
      "id": "prj_empty",
      "name": "empty",
      "environments": []
    }
  ]
}

